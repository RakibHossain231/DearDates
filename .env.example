# Database (SQLite locally, or PostgreSQL/Supabase for production)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session & Tokens
JWT_SECRET="your-super-secret-jwt-key"

# Secret token to protect the /api/cron/dispatch endpoint
CRON_SECRET="your-cron-secret-key"

# Resend API Key for Email Delivery (https://resend.com - Free 3,000 emails/month)
RESEND_API_KEY=""
EMAIL_FROM="AutoWISH <no-reply@yourdomain.com>"

# Google Gemini API Key for AI Wish Crafter (Free tier: https://aistudio.google.com)
GEMINI_API_KEY=""

# Telegram Bot Token (Free from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=""

# Android SMS / WhatsApp Gateway (Optional for direct SMS)
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
